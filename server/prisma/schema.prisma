generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model User {
  id            String   @id @default(uuid())
  firebaseUid   String   @unique
  fullName      String
  email         String   @unique
  emailVerified Boolean  @default(false)
  mobileNumber  String?  @unique
  mobileVerified Boolean @default(false)
  role          UserRole @default(USER)
  isSuspended   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vehicles          Vehicle[]
  orders            Order[]
  emergencyContacts EmergencyContact[]
  preferences       UserPreferences?
  reviews           Review[]
  sosAlerts         SosAlert[]
  notifications     Notification[]

  @@index([email])
  @@index([mobileNumber])
}

model UserPreferences {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  systemLanguage    String   @default("English (United Kingdom)")
  emailDigests      Boolean  @default(true)
  smsCriticalAlerts Boolean  @default(true)
  inAppPush         Boolean  @default(false)
  timeFormat        String   @default("24")
  updatedAt         DateTime @updatedAt
}

model EmergencyContact {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  phone     String
  email     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  orders    Order[]
  qrCodes   QrCode[]
  orderTags OrderTag[]

  @@index([userId])
}

model Vehicle {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  registration String
  nickname     String?
  vehicleType  String?
  brand        String?
  model        String?
  fuelType     String?
  color        String?
  isPrimary    Boolean  @default(false)
  qrCode       String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders       Order[]
  qrCodeRecord QrCode?
  orderTags    OrderTag[]

  @@index([userId])
}

enum QrCodeStatus {
  INACTIVE
  ACTIVE
  DISABLED
}

model QrCode {
  id             String        @id @default(uuid())
  code           String        @unique
  /// Sequential, human-readable identifier, shown to admin staff for quick
  /// lookup — never used in the scan URL, which stays on the random `code`
  /// for security. Backed by a DB sequence (autoincrement) so bulk-inserts
  /// assign gapless-per-request, unique numbers without a race condition.
  displaySeq     Int           @unique @default(autoincrement())
  /// 1-indexed position of this code within its batch (batchId), used to
  /// format the human-readable ID as sc-{batchName}-0001. Set once at
  /// creation time from the row's position in that bulk-insert — not a DB
  /// sequence, since numbering must restart at 1 for every new batch.
  batchSeq       Int           @default(1)
  status         QrCodeStatus  @default(INACTIVE)
  /// Status to restore when this code is re-enabled from DISABLED (ACTIVE if
  /// it was a live vehicle tag, INACTIVE if it had never been claimed yet).
  previousStatus QrCodeStatus?
  batchId        String
  batchName      String
  batchCreatedAt DateTime      @default(now())
  vehicleId      String?       @unique
  vehicle        Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  activatedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  /// Soft-delete marker. Set instead of a real row delete when an admin
  /// deletes a code from QR Code Management — it moves to the "Recover QR
  /// Codes" trash view and is excluded from every normal list/search/count.
  /// Only actually removed from the database when permanently deleted from
  /// that trash view.
  deletedAt      DateTime?

  emergencyContacts EmergencyContact[]
  maskedCallRequests MaskedCallRequest[]

  @@index([batchId])
  @@index([status])
  @@index([batchName])
  @@index([deletedAt])
}

/// One row per "masked call" setup a scanner completes after passing the
/// last-4-digit verification — records who asked to be connected (their own
/// phone number) and to whom, so a future Knowlarity click-to-call/SR-number
/// integration has an audit trail and a request to act on. `virtualNumber`
/// is filled in once a real masking provider is wired up; until then it's
/// null and the UI falls back to dialing the real destination number.
model MaskedCallRequest {
  id            String   @id @default(uuid())
  qrCodeId      String
  qrCode        QrCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  targetKind    String   // 'owner' | 'contact'
  targetIndex   Int?     // emergency contact index, when targetKind is 'contact'
  callerPhone   String
  virtualNumber String?
  createdAt     DateTime @default(now())

  callLogs CallLog[]

  @@index([qrCodeId])
}

/**
 * Call detail record pushed by Knowlarity once a masked call it bridged has
 * ended — the CDR-push side of the integration, separate from the
 * caller-initiated GET-destination-number lookup that starts a call.
 * `maskedCallRequestId` links back to the MaskedCallRequest our own
 * /:code/masked-call endpoint created for that caller, when a match is found
 * by phone number; it's nullable because a CDR can still arrive (and must
 * still be stored) for a call log our matching couldn't resolve.
 *
 * No field on this model is required by the partner endpoint itself — every
 * typed column below is nullable because Knowlarity's payload shape isn't
 * fixed. `providerCallId` is no longer unique (not guaranteed to be sent);
 * when present it's still used to upsert instead of insert, so retried
 * webhook deliveries for the same call don't duplicate. `rawPayload` always
 * has the complete original JSON body, key by key, regardless of which typed
 * columns could be filled in.
 */
model CallLog {
  id                   String             @id @default(uuid())
  maskedCallRequestId  String?
  maskedCallRequest    MaskedCallRequest? @relation(fields: [maskedCallRequestId], references: [id], onDelete: SetNull)
  callerNumber         String?            // E.164, e.g. +919458594043, when the payload included one
  destinationNumber    String?            // E.164, when the payload included one
  providerCallId       String?            // Knowlarity's own call/session id, when sent — used for idempotency + support lookups
  status               String?
  durationSeconds      Int?
  startedAt            DateTime?
  endedAt              DateTime?
  rawPayload           Json               // full payload exactly as received, kept for audit/debugging and to preserve any fields with no typed column
  createdAt            DateTime           @default(now())

  @@index([maskedCallRequestId])
  @@index([callerNumber])
  @@index([providerCallId])
  @@index([createdAt])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  priceInPaise Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  /// Structured breakdown of the physical tags one unit of this product
  /// contains, e.g. `[{"size":"car","count":2}]` for a "Car Tag (Pack of 2)",
  /// or `[{"size":"bike","count":2},{"size":"helmet","count":2}]` for a
  /// "Bike + Helmet Tag Combo (2+2)". `size` is a StickerSize value (see
  /// src/lib/qrSticker.ts) used both to know how many OrderTag rows to create
  /// per unit purchased and what physical sticker size each one downloads at.
  /// Empty/unset defaults to a single 'bike'-size tag (see
  /// server/src/lib/tagsPerUnit.ts) so older or manually-added products
  /// without this field still get exactly one tag, matching pre-this-feature
  /// behavior instead of silently producing zero tags.
  tagsPerUnit Json?

  orderItems OrderItem[]
}

model Order {
  id                  String            @id @default(uuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id])
  status              OrderStatus       @default(PENDING)
  subtotalInPaise     Int               @default(0)
  discountInPaise     Int               @default(0)
  totalInPaise        Int
  couponId            String?
  coupon              Coupon?           @relation(fields: [couponId], references: [id])
  couponCode          String?
  razorpayOrderId     String?           @unique
  razorpayPaymentId   String?
  razorpaySignature   String?
  /// Legacy single-tag fields — kept (not dropped) for backward compatibility
  /// with orders placed before per-tag QR codes (see OrderTag below) existed.
  /// No longer written for new orders; new orders express every physical tag
  /// as its own OrderTag row instead. A pre-migration order's one existing
  /// qrToken/vehicle/contact was carried over into a single OrderTag row by
  /// the migration, so old orders keep working unchanged through the new
  /// per-tag endpoints without needing these columns anymore — they remain
  /// only so nothing that still reads them directly breaks.
  qrToken             String?           @unique
  vehicleId           String?
  vehicle             Vehicle?          @relation(fields: [vehicleId], references: [id])
  emergencyContactId  String?
  emergencyContact    EmergencyContact? @relation(fields: [emergencyContactId], references: [id])
  shippingName        String?
  shippingPhone       String?
  shippingCity        String?
  shippingPincode     String?
  shippingAddress     String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  items  OrderItem[]
  tags   OrderTag[]
  review Review?

  @@index([userId])
  @@index([status])
  @@index([couponId])
}

/// One row per physical tag included in an order — e.g. a "Bike + Helmet Tag
/// Combo (2+2)" order creates 4 rows (2 size='bike', 2 size='helmet'), each
/// independently assignable to its own vehicle + emergency contact and
/// independently downloadable at its own correct sticker size. Replaces the
/// single qrToken/vehicleId/emergencyContactId that used to live directly on
/// Order (kept there only for pre-migration orders — see the comment above).
model OrderTag {
  id                  String            @id @default(uuid())
  orderId             String
  order               Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId         String
  orderItem           OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  /// StickerSize value ('car' | 'bike' | 'helmet' | 'transport') — see src/lib/qrSticker.ts.
  size                String
  /// 1-indexed position among this order's tags, purely for stable display
  /// ordering ("Tag 1 of 4") — not a uniqueness constraint on its own.
  sequence            Int
  qrToken             String            @unique
  vehicleId           String?
  vehicle             Vehicle?          @relation(fields: [vehicleId], references: [id])
  emergencyContactId  String?
  emergencyContact    EmergencyContact? @relation(fields: [emergencyContactId], references: [id])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([orderId])
  @@index([orderItemId])
  @@index([vehicleId])
}

enum CouponType {
  PERCENTAGE
  FIXED
}

/// Live, checkout-facing coupon — distinct from the unused DemoCoupon demo
/// model. percentageValue (0-100) is set for PERCENTAGE coupons,
/// fixedValueInPaise for FIXED coupons, so the meaning of the discount never
/// depends on reading `type` first.
model Coupon {
  id                 String     @id @default(uuid())
  code               String     @unique
  type               CouponType
  percentageValue    Int?
  fixedValueInPaise  Int?
  /// Optional floor — order subtotal must be at least this much for the
  /// coupon to apply. Null means no minimum.
  minOrderInPaise    Int?
  usageLimit         Int?
  usedCount          Int        @default(0)
  isActive           Boolean    @default(true)
  expiresAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  orders Order[]

  @@index([code])
}

model Review {
  id        String   @id @default(uuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  priceInPaise Int

  tags OrderTag[]

  @@index([orderId])
}

enum SosAlertStatus {
  ACTIVE
  RESOLVED
}

model SosAlert {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    SosAlertStatus @default(ACTIVE)
  latitude  Float?
  longitude Float?
  createdAt DateTime       @default(now())
  resolvedAt DateTime?

  @@index([userId])
  @@index([status])
}

enum NotificationType {
  ORDER_PAID
  MASKED_CALL
}

/// Real per-user notification, shown in the header bell — only ever created
/// server-side from a genuine event (order paid, someone tried to contact a
/// vehicle owner), never client-supplied.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  /// Optional deep-link path the frontend can navigate to on click (e.g. "/orders").
  linkPath  String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

model Reseller {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  address   String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ContactRequest {
  id        String   @id @default(uuid())
  fullName  String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/**
 * The models below back the "Demo Sections" of the admin panel: full CRUD is
 * available so admins can manage the records, but none of it drives live app
 * behavior yet (no real QR generation, IVR provider, coupon engine, or CMS
 * rendering) — the admin UI keeps a "Demo Data" banner on these pages.
 */

enum DemoQrStatus {
  ACTIVE
  DEACTIVATED
}

model DemoQrCode {
  id              String       @id @default(uuid())
  vehicleNickname String
  status          DemoQrStatus @default(ACTIVE)
  scans           Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

enum DemoStickerStatus {
  ORDERED
  SHIPPED
  DELIVERED
}

model DemoStickerOrder {
  id              String            @id @default(uuid())
  vehicleNickname String
  status          DemoStickerStatus @default(ORDERED)
  trackingId      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

enum DemoIvrStatus {
  ACTIVE
  INACTIVE
}

model DemoIvrNumber {
  id            String        @id @default(uuid())
  virtualNumber String
  assignedTo    String?
  status        DemoIvrStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model DemoSubscriptionPlan {
  id            String   @id @default(uuid())
  name          String
  priceInPaise  Int
  durationDays  Int
  features      String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum DemoCouponType {
  PERCENTAGE
  FIXED
}

model DemoCoupon {
  id         String         @id @default(uuid())
  code       String         @unique
  type       DemoCouponType
  value      Int
  usageLimit Int
  usedCount  Int            @default(0)
  expiresAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

enum DemoNotificationStatus {
  DRAFT
  SCHEDULED
  SENT
}

model DemoNotificationCampaign {
  id        String                  @id @default(uuid())
  title     String
  audience  String
  status    DemoNotificationStatus  @default(DRAFT)
  sentAt    DateTime?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
}

model DemoCmsPage {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DemoBanner {
  id        String   @id @default(uuid())
  title     String
  placement String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DemoFaq {
  id        String   @id @default(uuid())
  category  String
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DemoAuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  target    String
  createdAt DateTime @default(now())
}

model DemoCallLog {
  id        String   @id @default(uuid())
  fromLabel String
  toLabel   String
  duration  Int
  status    String
  createdAt DateTime @default(now())
}

model DemoSystemConfig {
  id                        String  @id @default("singleton")
  smtpConfigured            Boolean @default(false)
  smsGatewayConfigured      Boolean @default(false)
  pushNotificationsConfigured Boolean @default(true)
  paymentGatewayConfigured  Boolean @default(true)
  cloudIvrConfigured        Boolean @default(false)
  maintenanceMode           Boolean @default(false)
  appVersion                String  @default("1.0.0")
  updatedAt                 DateTime @updatedAt
}
