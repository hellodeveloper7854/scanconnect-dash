generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model User {
  id            String   @id @default(uuid())
  firebaseUid   String   @unique
  fullName      String
  email         String   @unique
  emailVerified Boolean  @default(false)
  mobileNumber  String?  @unique
  mobileVerified Boolean @default(false)
  role          UserRole @default(USER)
  isSuspended   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vehicles          Vehicle[]
  orders            Order[]
  emergencyContacts EmergencyContact[]
  preferences       UserPreferences?
  reviews           Review[]
  sosAlerts         SosAlert[]

  @@index([email])
  @@index([mobileNumber])
}

model UserPreferences {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  systemLanguage    String   @default("English (United Kingdom)")
  emailDigests      Boolean  @default(true)
  smsCriticalAlerts Boolean  @default(true)
  inAppPush         Boolean  @default(false)
  timeFormat        String   @default("24")
  updatedAt         DateTime @updatedAt
}

model EmergencyContact {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  phone     String
  email     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  orders Order[]

  @@index([userId])
}

model Vehicle {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  registration String
  nickname     String?
  vehicleType  String?
  brand        String?
  model        String?
  fuelType     String?
  color        String?
  isPrimary    Boolean  @default(false)
  qrCode       String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]

  @@index([userId])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  priceInPaise Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  orderItems OrderItem[]
}

model Order {
  id                  String            @id @default(uuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id])
  status              OrderStatus       @default(PENDING)
  totalInPaise        Int
  razorpayOrderId     String?           @unique
  razorpayPaymentId   String?
  razorpaySignature   String?
  qrToken             String?           @unique
  vehicleId           String?
  vehicle             Vehicle?          @relation(fields: [vehicleId], references: [id])
  emergencyContactId  String?
  emergencyContact    EmergencyContact? @relation(fields: [emergencyContactId], references: [id])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  items  OrderItem[]
  review Review?

  @@index([userId])
  @@index([status])
}

model Review {
  id        String   @id @default(uuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  priceInPaise Int

  @@index([orderId])
}

enum SosAlertStatus {
  ACTIVE
  RESOLVED
}

model SosAlert {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    SosAlertStatus @default(ACTIVE)
  latitude  Float?
  longitude Float?
  createdAt DateTime       @default(now())
  resolvedAt DateTime?

  @@index([userId])
  @@index([status])
}

/**
 * The models below back the "Demo Sections" of the admin panel: full CRUD is
 * available so admins can manage the records, but none of it drives live app
 * behavior yet (no real QR generation, IVR provider, coupon engine, or CMS
 * rendering) — the admin UI keeps a "Demo Data" banner on these pages.
 */

enum DemoQrStatus {
  ACTIVE
  DEACTIVATED
}

model DemoQrCode {
  id              String       @id @default(uuid())
  vehicleNickname String
  status          DemoQrStatus @default(ACTIVE)
  scans           Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

enum DemoStickerStatus {
  ORDERED
  SHIPPED
  DELIVERED
}

model DemoStickerOrder {
  id              String            @id @default(uuid())
  vehicleNickname String
  status          DemoStickerStatus @default(ORDERED)
  trackingId      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

enum DemoIvrStatus {
  ACTIVE
  INACTIVE
}

model DemoIvrNumber {
  id            String        @id @default(uuid())
  virtualNumber String
  assignedTo    String?
  status        DemoIvrStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model DemoSubscriptionPlan {
  id            String   @id @default(uuid())
  name          String
  priceInPaise  Int
  durationDays  Int
  features      String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum DemoCouponType {
  PERCENTAGE
  FIXED
}

model DemoCoupon {
  id         String         @id @default(uuid())
  code       String         @unique
  type       DemoCouponType
  value      Int
  usageLimit Int
  usedCount  Int            @default(0)
  expiresAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

enum DemoNotificationStatus {
  DRAFT
  SCHEDULED
  SENT
}

model DemoNotificationCampaign {
  id        String                  @id @default(uuid())
  title     String
  audience  String
  status    DemoNotificationStatus  @default(DRAFT)
  sentAt    DateTime?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
}

model DemoCmsPage {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DemoBanner {
  id        String   @id @default(uuid())
  title     String
  placement String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DemoFaq {
  id        String   @id @default(uuid())
  category  String
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DemoAuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  target    String
  createdAt DateTime @default(now())
}

model DemoCallLog {
  id        String   @id @default(uuid())
  fromLabel String
  toLabel   String
  duration  Int
  status    String
  createdAt DateTime @default(now())
}

model DemoSystemConfig {
  id                        String  @id @default("singleton")
  smtpConfigured            Boolean @default(false)
  smsGatewayConfigured      Boolean @default(false)
  pushNotificationsConfigured Boolean @default(true)
  paymentGatewayConfigured  Boolean @default(true)
  cloudIvrConfigured        Boolean @default(false)
  maintenanceMode           Boolean @default(false)
  appVersion                String  @default("1.0.0")
  updatedAt                 DateTime @updatedAt
}
