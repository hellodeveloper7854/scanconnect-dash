# Postgres connection (VPS)
DATABASE_URL="postgresql://scanconnect_user:CHANGE_ME@YOUR_VPS_IP:5432/scanconnect?schema=public"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Firebase Admin SDK (paste the values from your service account JSON)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Razorpay
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Admin bootstrap (first admin account promotion)
ADMIN_BOOTSTRAP_EMAILS="you@example.com"
