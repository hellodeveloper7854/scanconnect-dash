# Postgres connection (VPS)
DATABASE_URL="postgresql://scanconnect_user:CHANGE_ME@YOUR_VPS_IP:5432/scanconnect?schema=public"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Firebase Admin SDK (paste the values from your service account JSON)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Razorpay
# PAYMENT_MODE selects which credential set below is used: "live" uses the
# RAZORPAY_LIVE_* values (real charges), anything else (or unset) uses
# RAZORPAY_TEST_* — keep this "test" everywhere except production.
PAYMENT_MODE="test"

RAZORPAY_TEST_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_TEST_KEY_SECRET="your_razorpay_test_secret"
RAZORPAY_TEST_WEBHOOK_SECRET="your_test_webhook_secret"

RAZORPAY_LIVE_KEY_ID="rzp_live_xxxxxxxx"
RAZORPAY_LIVE_KEY_SECRET="your_razorpay_live_secret"
RAZORPAY_LIVE_WEBHOOK_SECRET="your_live_webhook_secret"

# Admin bootstrap (first admin account promotion)
ADMIN_BOOTSTRAP_EMAILS="you@example.com"

# Knowlarity click-to-call (masked calling). Leave unset to fall back to unmasked.
KNOWLARITY_API_KEY=
KNOWLARITY_SR_API_KEY=
KNOWLARITY_K_NUMBER=
KNOWLARITY_CHANNEL=Basic
